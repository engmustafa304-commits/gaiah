# انسخ هذا الملف إلى .env (لا ترفع .env إلى أي مستودع)
# التشغيل المحلي لا يحتاج أي متغير؛ القيم الافتراضية تكفي للتطوير.

PORT=3000
NODE_ENV=development

# مجلد قاعدة البيانات (SQLite). في الاستضافة وجّهه إلى قرص دائم، مثل /data
DATA_DIR=./data

# --- مطلوب في الإنتاج ---
# الدومين بدون https:// (مثال: example.com). يجب أن يشير سجل A له إلى IP الخادم
DOMAIN=
# سر توقيع الجلسات: نص عشوائي طويل. ولّده بالأمر:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# بيانات تجريبية؟ في الإنتاج الافتراضي false (قاعدة فارغة). اجعلها true فقط للتجربة
SEED_DEMO=false
# السماح بزر إعادة الضبط في الإنتاج (اتركه false)
ALLOW_RESET=false
# خلف وكيل عكسي (Caddy/Nginx/المنصة) فعّل الثقة بالترويسات
TRUST_PROXY=true
